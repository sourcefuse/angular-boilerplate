{
  "name": "@arc/boiler-plate",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:arc-docs": "ng serve arc-docs --port 4200",
    "start:arc": "ng serve arc --port 4201",
    "start:saas-ui": "ng serve saas-ui --port 4202",
    "build": "ng build",
    "test": "ng test",
    "lint": "eslint projects/**/*.ts",
    "lint:fix": "npm run lint -- --fix",
    "e2e:all": "npm run e2e:arc-docs && npm run e2e:arc && npm run e2e:saas-ui",
    "e2e:arc-docs": "playwright test --config=e2e/arc-docs/playwright.config.ts",
    "e2e:arc": "playwright test --config=e2e/arc/playwright.config.ts",
    "e2e:saas-ui": "playwright test --config=e2e/saas-ui/playwright.config.ts",
    "e2e:headed": "playwright test --headed --config=e2e/arc-docs/playwright.config.ts",
    "config": "ts-node setenv.ts",
    "prettier:cli": "prettier \"**/*.ts\" \"**/*.js\" \"**/*.html\" \"**/*.scss\"",
    "prettier:check": "npm run prettier:cli -- -l",
    "prettier:fix": "npm run prettier:cli -- --write",
    "prepare": "husky install"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.26",
    "@angular/cdk": "~21.0.6",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "~21.0.6",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@nebular/auth": "^17.0.0",
    "@nebular/date-fns": "^17.0.0",
    "@nebular/eva-icons": "17.0.0",
    "@nebular/theme": "^17.0.0",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "@stripe/stripe-js": "^4.9.0",
    "@types/lodash": "^4.14.194",
    "ag-grid-angular": "^31.3.1",
    "ag-grid-community": "^31.3.1",
    "date-fns": "^2.29.3",
    "dotenv": "^16.0.3",
    "eva-icons": "^1.1.3",
    "lodash": "^4.18.1",
    "ngx-logger": "^5.0.12",
    "ngx-permissions": "^15.0.1",
    "ngx-webstorage-service": "^5.0.0",
    "or": "^0.2.0",
    "prettier": "^2.8.7",
    "rxjs": "~7.8.0",
    "ts-node": "^10.9.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.31",
    "@angular-eslint/builder": "21.4.0",
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/schematics": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/cli": "~21.2.31",
    "@angular/compiler-cli": "^21.2.26",
    "@playwright/test": "^1.56.1",
    "@schematics/angular": "~21.2.31",
    "@types/date-fns": "^2.6.0",
    "@types/jasmine": "~4.3.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.0.0",
    "dhtmlx-gantt": "^7.1.13",
    "eslint": "^8.57.0",
    "husky": "^8.0.3",
    "jasmine-core": "~4.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^21.2.7",
    "prettier": "^3.1.1",
    "typescript": "~5.9.3",
    "webpack": "^5.89.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    }
  }
}
